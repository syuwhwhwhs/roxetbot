#!/usr/bin/env bash
# Global roxet wrapper — works from any directory.
# Installed to /usr/local/bin/roxet by scripts/install_global_cli.sh
set -euo pipefail

MARKER="/usr/local/lib/roxetbot/install_root"
ROOT="${ROXET_HOME:-${ROXET_ROOT:-}}"

if [[ -z "${ROOT}" && -f "${MARKER}" ]]; then
  ROOT="$(tr -d '\r' < "${MARKER}" | head -n1 | sed 's/[[:space:]]*$//')"
fi

# Dev fallback: repo containing this script (scripts/roxet → ..)
if [[ -z "${ROOT}" ]]; then
  HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -f "${HERE}/../run.py" && -d "${HERE}/../app" ]]; then
    ROOT="$(cd "${HERE}/.." && pwd)"
  fi
fi

if [[ -z "${ROOT}" || ! -d "${ROOT}" ]]; then
  echo "roxet: install root not found." >&2
  echo "Set ROXET_HOME or run: sudo bash scripts/install_global_cli.sh" >&2
  exit 1
fi

PY="${ROOT}/.venv/bin/python"
if [[ ! -x "${PY}" ]]; then
  PY="$(command -v python3 || true)"
fi
if [[ -z "${PY}" ]]; then
  echo "roxet: python not found in ${ROOT}/.venv or PATH" >&2
  exit 1
fi

export ROXET_HOME="${ROOT}"
cd "${ROOT}"
exec "${PY}" -m app.cli "$@"
